# ================= Database =================
# Preview/default (SQLite, file created automatically on startup):
DATABASE_URL=sqlite+aiosqlite:///./reqlint.db
# Alternative (external PostgreSQL, used by docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/reqlint

# ===== Redis & queue (only needed if AUDIT_EXECUTION_MODE=celery) =====
REDIS_URL=redis://localhost:6379/0
AUDIT_EXECUTION_MODE=inline
# inline = FastAPI BackgroundTasks (no Redis/Celery needed)
# celery = Celery workers + Redis

# ================= JWT Authentication =================
# REQUIRED in deployment: generate e.g. with `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=ganti-ini-dengan-secret-acak-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
BCRYPT_ROUNDS=12

# ================ File & Content Limits ================
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=50000
TEMP_DIR=./storage/cache
TEMP_TTL_MINUTES=60

# ============ SLM (Stage 2) — three options ============
# 1) Groq cloud API (recommended for deployment, needs GROQ_API_KEY):
# SLM_PROVIDER=openai_compatible
# SLM_BASE_URL=https://api.groq.com/openai
# SLM_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=gsk_your_key_here
# 2) Local Ollama:
# SLM_PROVIDER=ollama
# SLM_BASE_URL=http://localhost:11434
# SLM_MODEL=phi3:mini
# 3) Offline mock (default if unset; no external service needed):
# SLM_PROVIDER=mock
SLM_TIMEOUT_SECONDS=4
# naikkan saat dev di laptop (PERF-2 target total <5 dtk)

# ================= CORS =================
# Comma-separated list of allowed frontend origins.
# For Coolify preview set this to the frontend domain, e.g.
# CORS_ORIGINS=https://frontend.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
