# ================= Database =================
# Preview/default (SQLite, file created automatically on startup):
DATABASE_URL=sqlite+aiosqlite:///./reqlint.db
# Alternative (external PostgreSQL, used by docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/reqlint

# ===== Redis & queue (only needed if AUDIT_EXECUTION_MODE=celery) =====
REDIS_URL=redis://localhost:6379/0
AUDIT_EXECUTION_MODE=inline
# inline = FastAPI BackgroundTasks (no Redis/Celery needed)
# celery = Celery workers + Redis

# ================= Runtime environment =================
# 'dev' (default) = missing JWT_SECRET is replaced with an ephemeral random
# per-process value. Any other value ('production', 'staging', ...) = the app
# REFUSES TO START without an explicit JWT_SECRET (P0/SEC-01 fail-fast).
ENV=dev

# ================= JWT Authentication =================
# REQUIRED when ENV != 'dev': generate e.g. with `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=ganti-ini-dengan-secret-acak-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
BCRYPT_ROUNDS=12

# ================ File & Content Limits ================
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=50000
TEMP_DIR=./storage/cache
TEMP_TTL_MINUTES=60

# ============ SLM (Stage 2) — three options ============
# IMPORTANT: define each SLM_* variable EXACTLY ONCE in your .env.
# python-dotenv lets the LAST assignment win, so uncommenting several blocks
# at once silently switches the provider to the last block (this caused the
# Task 09 "provider stuck on mock" incident).
# Verify the model ID against the live catalog: GET https://api.groq.com/openai/v1/models
# (e.g. llama-3.1-8b-instant is no longer served; openai/gpt-oss-120b or
# openai/gpt-oss-20b are currently verified working).
# 1) Groq cloud API (recommended for deployment, needs GROQ_API_KEY):
# SLM_PROVIDER=openai_compatible
# SLM_BASE_URL=https://api.groq.com/openai
# SLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=gsk_your_key_here
# 2) Local Ollama:
# SLM_PROVIDER=ollama
# SLM_BASE_URL=http://localhost:11434
# SLM_MODEL=phi3:mini
# 3) Offline mock (default if unset; no external service needed):
# SLM_PROVIDER=mock
SLM_TIMEOUT_SECONDS=20
# real LLM calls need ~2-10 s; the mock provider never uses this value

# ================= CORS =================
# Comma-separated list of allowed frontend origins.
# For Coolify preview set this to the frontend domain, e.g.
# CORS_ORIGINS=https://frontend.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ===== Task 06: password-reset email delivery (optional) =====
# Empty SMTP_HOST disables sending: forgot-password still records a token but
# it is NOT delivered (real-email delivery pending deployment credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reqlint@localhost
SMTP_FROM_NAME=ReqLint
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PUBLIC_BASE_URL=http://localhost:3000
CONTACT_RECIPIENT_EMAIL=
