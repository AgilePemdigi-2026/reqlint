# Base URL of the ReqLint backend API (no trailing slash).
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# For a Coolify deployment this MUST be set as a BUILD-TIME variable (build arg).

# --- Single-domain deployment (docker-compose.coolify.yml) ---
# The compose stack sets NEXT_PUBLIC_API_URL=/api/v1 (same-origin relative path):
# the browser calls <public-domain>/api/v1/* and Next.js proxies /api/* to the
# backend via the rewrites in next.config.js. The proxy target is controlled by
# the BUILD-TIME variable API_PROXY_TARGET (default http://backend:8000, matching
# the compose service name). Rewrites are resolved at build time, so both values
# are build args, not runtime env vars.
